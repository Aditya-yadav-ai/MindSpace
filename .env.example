# MindSpace Stage 8 — Production Environment Configuration Reference
# Duplicate this file to `.env` in the project root and fill in your values.
# NEVER commit real credentials, tokens, or encryption keys to version control.

# ==============================================================================
# 1. Google Workspace & Platform Services Integration (14 Supported Services)
# ==============================================================================
# Create an OAuth 2.0 Web Application client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Ensure the following redirect URI is authorized:
#   http://localhost:3000/api/google/oauth-callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth-callback"

# Backend-controlled API key for Google Maps Platform services (Places, Geocoding, Distance, Directions).
# Keep this secret; it is never exposed to the Chrome Extension or browser clients.
GOOGLE_MAPS_API_KEY=""

# 32-byte secret key used to encrypt OAuth refresh/access tokens at rest with AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Required Google Cloud API Scopes for MindSpace 14 Official Service Adapters:
# 1. Gmail:
#    - https://www.googleapis.com/auth/gmail.readonly
#    - https://www.googleapis.com/auth/gmail.compose
# 2. Google Calendar:
#    - https://www.googleapis.com/auth/calendar.events
# 3. Google Drive:
#    - https://www.googleapis.com/auth/drive.file
# 4. Google Docs:
#    - https://www.googleapis.com/auth/documents
# 5. Google Sheets:
#    - https://www.googleapis.com/auth/spreadsheets
# 6. Google Slides:
#    - https://www.googleapis.com/auth/presentations
# 7. Google Meet:
#    - https://www.googleapis.com/auth/meetings.space.created
#    - https://www.googleapis.com/auth/meetings.space.readonly
# 8. Google Forms:
#    - https://www.googleapis.com/auth/forms.body
#    - https://www.googleapis.com/auth/forms.responses.readonly
# 9. Google Tasks:
#    - https://www.googleapis.com/auth/tasks
# 10. Google Contacts:
#    - https://www.googleapis.com/auth/contacts
#    - https://www.googleapis.com/auth/contacts.readonly
# 11. Google Chat:
#    - https://www.googleapis.com/auth/chat.spaces.readonly
#    - https://www.googleapis.com/auth/chat.messages
#    - https://www.googleapis.com/auth/chat.memberships.readonly
# 12. Google Maps:
#    - Backend GOOGLE_MAPS_API_KEY (Places API, Geocoding API, Distance Matrix API, Directions API)
# 13. Google Classroom:
#    - https://www.googleapis.com/auth/classroom.courses.readonly
#    - https://www.googleapis.com/auth/classroom.coursework.me
#    - https://www.googleapis.com/auth/classroom.announcements
# 14. YouTube:
#    - https://www.googleapis.com/auth/youtube.readonly
#    - https://www.googleapis.com/auth/youtube
#
# NOTE: Google Keep and Google Photos are EXPLICITLY EXCLUDED and NOT supported.

# ==============================================================================
# 2. MindSpace Python MAS / Multi-Agent Service API
# ==============================================================================
PORT=8010
HOST="127.0.0.1"
ENVIRONMENT="production" # Options: development, test, production

# MindSpace API Authentication Key (Required in production)
MINDSPACE_API_KEY=""

# Allowed Chrome Extension IDs (comma-separated; restricts CORS in production)
ALLOWED_EXTENSION_IDS=""

# In-memory sliding window rate limit per client/minute
RATE_LIMIT_PER_MINUTE=60

# LLM inference API Key (Groq). When empty or offline, MindSpace operates in
# transparently labelled offline simulated mode without fabricating live AI results.
GROQ_API_KEY=""

# Configured LLM Models:
# Text & reasoning agent model:
MODEL="groq/llama-3.1-8b-instant"
# Multimodal vision agent model:
VISION_MODEL="groq/llama-3.2-11b-vision-preview"

# Explicit mode override: 1 = force offline simulated mode, 0 = require live credentials
MINDSPACE_OFFLINE=1

# ==============================================================================
# 3. Supabase Database & Auth (Optional for cloud sync)
# ==============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
