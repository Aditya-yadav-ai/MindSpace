# MindSpace Python API Service Configuration
# Duplicate to .env inside apps/api/ if configuring standalone service

PORT=8000
HOST="127.0.0.1"
SERVICE_NAME="mindspace-agent-api"

# Groq API Key for live inference. Leave blank for transparent labelled offline mode.
GROQ_API_KEY=""

# Configured LLM Models:
MODEL="groq/llama-3.1-8b-instant"
VISION_MODEL="groq/llama-3.2-11b-vision-preview"

LLM_TIMEOUT_SECONDS=25.0
CORS_ORIGINS=""

# Explicit offline switch: 1 forces mock/offline mode, 0 requires valid key
MINDSPACE_OFFLINE=1
